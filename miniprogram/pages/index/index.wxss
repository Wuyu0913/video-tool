/* ============ 全局 ============ */
page {
  background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
  min-height: 100vh;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* ============ 头部 ============ */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(90deg, #667eea, #764ba2, #f093fb);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ============ 输入卡片 ============ */
.input-card {
  margin: 0 30rpx;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  padding: 30rpx;
}

.input-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 20rpx;
}

.platform-tags {
  display: flex;
  gap: 8rpx;
}

.tag {
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}

.input-wrapper {
  display: flex;
  gap: 16rpx;
}

.url-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
}

.url-input::placeholder {
  color: rgba(255, 255, 255, 0.3);
}

.parse-btn {
  height: 88rpx;
  padding: 0 40rpx;
  border: none;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
  flex-shrink: 0;
}

.parse-btn[disabled] {
  opacity: 0.5;
}

/* ============ 统计栏 ============ */
.stats-bar {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.exhausted {
  color: #ffd700;
}

/* ============ 加载 ============ */
.loading {
  display: none;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading.active {
  display: flex;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.1);
  border-top-color: #667eea;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* ============ 错误 ============ */
.error-msg {
  display: none;
  margin: 0 30rpx 20rpx;
  padding: 24rpx;
  background: rgba(255, 77, 77, 0.1);
  border: 1px solid rgba(255, 77, 77, 0.2);
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #ff6b6b;
}

.error-msg.active {
  display: block;
}

/* ============ 结果卡片 ============ */
.result-card {
  display: none;
  margin: 0 30rpx;
  background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  overflow: hidden;
  animation: slideUp 0.4s ease;
}

.result-card.active {
  display: block;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 封面 */
.video-cover {
  position: relative;
  width: 100%;
  height: 420rpx;
  background: #1a1a2e;
  overflow: hidden;
}

.video-cover image {
  width: 100%;
  height: 100%;
}

.play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 96rpx;
  height: 96rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
}

.play-icon-inner {
  width: 0;
  height: 0;
  border-left: 32rpx solid #fff;
  border-top: 20rpx solid transparent;
  border-bottom: 20rpx solid transparent;
  margin-left: 6rpx;
}

/* 信息 */
.video-info {
  padding: 24rpx;
}

.video-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.video-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 24rpx;
}

.platform-badge {
  padding: 4rpx 20rpx;
  background: rgba(102, 126, 234, 0.2);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #667eea;
}

/* 下载按钮 */
.action-buttons {
  display: flex;
  gap: 16rpx;
}

.btn-download {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-ad {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #f093fb, #f5576c);
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ============ 视频预览弹窗 ============ */
.video-modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  z-index: 1000;
}

.video-modal.active {
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  position: relative;
  width: 100%;
}

.preview-video {
  width: 100%;
  height: 500rpx;
}

.modal-close {
  position: fixed;
  top: 60rpx;
  right: 30rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  text-align: center;
  line-height: 60rpx;
  font-size: 32rpx;
  color: #fff;
  z-index: 1001;
}

/* ============ 底部 ============ */
.footer {
  text-align: center;
  padding: 40rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.2);
}